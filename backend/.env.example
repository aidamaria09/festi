PORT=4000
# Path to the SQLite file. Omit to use ./data/festi.sqlite
DB_PATH=
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# RapidAPI key, used for live flight prices in the trip planner via the "Sky Scrapper"
# API (a Skyscanner-data wrapper, free BASIC tier): https://rapidapi.com/apiheya/api/sky-scrapper
# 1. Sign up free at rapidapi.com
# 2. Open the "Sky Scrapper" API listing above and subscribe to the BASIC ($0.00/mo) plan
# 3. Copy your key from the listing's code snippets (or Developer Dashboard > Apps > Security)
# If left blank, the flights endpoint responds with { configured: false } and the
# frontend shows a note + a working Skyscanner search link instead of live prices.
RAPIDAPI_KEY=
