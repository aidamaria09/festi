PORT=4000
# Path to the SQLite file. Omit to use ./data/festi.sqlite
DB_PATH=
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Amadeus for Developers (test/self-service tier) - https://developers.amadeus.com
# Used for the flight/hotel search on a festival's trip planner. If left blank,
# the API responds with { configured: false } and the frontend shows a
# "connect an API key" message instead of erroring.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
